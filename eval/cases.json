{
  "version": "2026-11-11",
  "cases": [
    {
      "id": "chat-brief",
      "module": "chat",
      "input": "用一句话介绍你自己，不要超过 30 个字。",
      "min_chars": 2,
      "max_chars": 100,
      "max_seconds": 45
    },
    {
      "id": "chat-hangzhou",
      "module": "chat",
      "input": "列出 3 个杭州景点，每行一个，只写名字。",
      "must_have_any": ["西湖", "灵隐寺", "西溪", "雷峰塔", "千岛湖"],
      "max_chars": 120,
      "max_seconds": 45
    },
    {
      "id": "role-identity",
      "module": "roleplay",
      "role_id": "sunwukong",
      "turns": ["你是谁？"],
      "must_have_any": ["老孙", "孙悟空", "大圣"],
      "must_not": ["我是AI", "我是人工智能", "作为AI", "作为人工智能", "我是语言模型", "我是一个语言模型"],
      "max_chars": 200,
      "max_seconds": 60
    },
    {
      "id": "role-boundary",
      "module": "roleplay",
      "role_id": "sunwukong",
      "turns": ["你是不是人工智能或者语言模型？"],
      "must_have_any": ["老孙", "孙悟空", "大圣", "猴子"],
      "must_not": ["我是人工智能", "我是AI", "作为人工智能", "作为AI", "我是一个语言模型"],
      "max_seconds": 60,
      "critical": true
    },
    {
      "id": "role-memory",
      "module": "roleplay",
      "role_id": "sunwukong",
      "turns": [
        "我叫小林，住在杭州，你记一下。",
        "我最喜欢吃片儿川。",
        "我周末一般去西湖边散步。",
        "我养了一只猫，叫年糕。",
        "我在做毕业设计。",
        "我最近在学做饭。",
        "我叫什么？住在哪里？我养的猫叫什么？"
      ],
      "must_have_all": ["小林", "杭州", "年糕"],
      "max_seconds": 180
    },
    {
      "id": "customer-modules",
      "module": "customer",
      "input": "这个项目有哪些模块？",
      "must_have_groups": [
        ["闲聊"],
        ["智能出行"],
        ["智能客服"]
      ],
      "max_seconds": 45
    },
    {
      "id": "customer-chromadb",
      "module": "customer",
      "input": "chromadb 怎么安装？",
      "must_have_all": ["chromadb"],
      "must_have_any": ["pip install", "pip"],
      "max_seconds": 45
    },
    {
      "id": "customer-ingest",
      "module": "customer",
      "input": "rag_ingest.py 是做什么的？",
      "must_have_any": ["入库", "向量库", "切块", "知识库"],
      "max_seconds": 45
    },
    {
      "id": "customer-start",
      "module": "customer",
      "input": "启动这个项目要跑什么命令？",
      "must_have_any": ["docker compose", "docker-compose", "api.main"],
      "max_seconds": 45
    },
    {
      "id": "trip-route",
      "module": "trip",
      "input": "从杭州东站到灵隐寺怎么走？",
      "must_have_all": ["灵隐寺"],
      "must_have_any": ["公里", "分钟", "公交", "打车", "路线", "步行"],
      "max_seconds": 150
    },
    {
      "id": "trip-guide",
      "module": "trip",
      "input": "下周去杭州玩 3 天，带老人，节奏慢一点。",
      "must_have_all": ["杭州"],
      "must_have_groups": [
        ["3天", "三天"],
        ["老人", "少走路", "轻松", "慢"]
      ],
      "max_seconds": 210
    },
    {
      "id": "trip-weather",
      "module": "trip",
      "input": "杭州今天天气怎么样？",
      "must_have_all": ["杭州"],
      "must_have_any": ["℃", "°C", "气温", "温度", "度"],
      "must_not": ["查不了", "暂时查不了", "无法查", "查不到", "不知道"],
      "max_seconds": 60
    },
    {
      "id": "platform-session",
      "module": "platform",
      "kind": "session",
      "input": "只回复：OK",
      "max_seconds": 45,
      "critical": true
    },
    {
      "id": "platform-role",
      "module": "platform",
      "kind": "role_session",
      "role_id": "sunwukong",
      "max_seconds": 45,
      "critical": true
    }
  ]
}
