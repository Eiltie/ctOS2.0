DEEPSEEK_API_KEY=your key
DEEPSEEK_BASE_URL=your url
DEEPSEEK_MODEL= your model

#高德api
AMAP_KEY=your key

# ===== 向量化（智能客服的文档检索）=====
# 用本机跑的 Ollama，不需要密钥，也不用联网。
# 使用前先装好 Ollama 并拉模型：ollama pull qwen3-embedding:0.6b
# 换模型的话改 OLLAMA_EMBED_MODEL，然后必须重跑一次入库脚本。
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ===== PostgreSQL =====
# 本地实装（D:\PostgreSQL），先运行 start-db.bat 启动
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=ctos2
PG_USER=ctos_app
PG_PASSWORD=your pg app password

# 建库用的超级用户
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=your pg superuser password
