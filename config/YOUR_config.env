DEEPSEEK_API_KEY=your key
DEEPSEEK_BASE_URL=your url
DEEPSEEK_MODEL= your model

#高德api
AMAP_KEY=your key

#智谱api，向量数据库
ZHIPU_API_KEY=

# ===== PostgreSQL =====
# 本地实装（D:\PostgreSQL），先运行 start-db.bat 启动
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=ctos2
PG_USER=ctos_app
PG_PASSWORD=your pg app password

# 建库用的超级用户
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=your pg superuser password
